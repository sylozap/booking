# Configuration for the identity service. Every variable is read at startup and
# validated before the process serves traffic; an invalid or incomplete set
# terminates it with exit code 78 and a report naming the variables (D54).
#
# Copy to .env for local use. The file is never committed: .env is ignored, and
# the values below are placeholders, not secrets.

# --- required, no defaults -------------------------------------------------
# These have no fallback on purpose. A default database address silently
# connects a misconfigured process to something, and the something is usually
# localhost.

IDENTITY_ENVIRONMENT=local
IDENTITY_DATABASE_DSN=postgresql+asyncpg://identity:identity_local_dev@localhost:5433/identity
IDENTITY_REDIS_DSN=redis://localhost:6379/0
IDENTITY_OTLP_ENDPOINT=http://localhost:4317

# --- optional, safe defaults shown -----------------------------------------

# IDENTITY_SERVICE_NAME=identity
# IDENTITY_SERVICE_VERSION=0.1.0
# IDENTITY_LOG_LEVEL=INFO

# IDENTITY_HTTP_HOST=0.0.0.0
# IDENTITY_HTTP_PORT=8000

# IDENTITY_DATABASE_POOL_SIZE=10
# IDENTITY_DATABASE_POOL_MAX_OVERFLOW=5

# Readiness must answer well inside the kubelet timeout; a probe that hangs
# keeps traffic flowing to a pod that cannot serve it.
# IDENTITY_READINESS_TIMEOUT_SECONDS=2.0
